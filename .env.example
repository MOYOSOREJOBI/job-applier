# Job Applier — Environment Variables (copy to .env and fill in values)

ARTIFACT_ENGINE_MODE=llm
GEMINI_API_KEY=your_gemini_api_key_here

# Email (Gmail App Password — generate at myaccount.google.com/apppasswords)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993

# PostgreSQL (Neon/Supabase/Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auto-Apply
AUTO_APPLY_ENABLED=true
AUTO_APPLY_DAILY_CAP=25
SCRAPE_INTERVAL_HOURS=6
MIN_SCORE_TO_APPLY=65
